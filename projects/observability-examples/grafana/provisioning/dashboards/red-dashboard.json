{
  "title": "RED + Trace (Minimal)",
  "uid": "red-minimal",
  "schemaVersion": 39,
  "panels": [
    {
      "title": "Request Rate (RED: Rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(http_requests_total[5m])) by (route)", "legendFormat": "{{route}}" }
      ]
    },
    {
      "title": "Error Rate (RED: Errors)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(rate(http_requests_total{status=\"500\"}[5m])) by (route) / sum(rate(http_requests_total[5m])) by (route)", "legendFormat": "{{route}} err%" }
      ]
    },
    {
      "title": "Duration P95/P99 (RED: Duration)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "p95 {{route}}" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "p99 {{route}}" }
      ]
    },
    {
      "title": "Logs (trace_id 关联)",
      "type": "logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        { "expr": "{job=\"app\"} | json" }
      ]
    }
  ]
}
