# Copy this file to .env and fill in values for your machine.

OBSIDIAN_VAULT_PATH=""             # absolute path to your Obsidian vault root
OBSIDIAN_SOURCES_DIR=""            # comma-separated source dirs for wiki-ingest
OBSIDIAN_CATEGORIES="concepts,entities,skills,references,synthesis,journal"
OBSIDIAN_MAX_PAGES_PER_INGEST=15
CLAUDE_HISTORY_PATH=""             # blank = auto-discover from ~/.claude
OBSIDIAN_LINK_FORMAT="wikilink"
OBSIDIAN_RAW_DIR="_raw"

# WIKI_TOKEN_WARN_THRESHOLD=0       # 0 disables token-footprint warnings
# WIKI_STAGED_WRITES=true           # route LLM-written pages through _staging/

# Optional integrations (qmd semantic search)
# QMD_WIKI_COLLECTION=""
# QMD_PAPERS_COLLECTION=""
# QMD_TRANSPORT="mcp"
# QMD_CLI_SEARCH_MODE="quality"
# QMD_CLI="qmd"